# -----------------------------------------------------------------------------
# DTS API environment
# Copy to apps/api/.env and fill in the blanks. Never commit the filled copy.
# -----------------------------------------------------------------------------

# -- Database -----------------------------------------------------------------
# Neon pooled connection string for the DTS project.
# Format: postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/dts?sslmode=require
DATABASE_URL=

# -- Auth ---------------------------------------------------------------------
# Must be at least 16 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
# Access token lifetime in seconds (default 900 = 15 minutes)
ACCESS_TOKEN_TTL=900
# Refresh token lifetime in days (default 30)
REFRESH_TOKEN_TTL_DAYS=30

# -- App ----------------------------------------------------------------------
# Public origin of the deployed app, used in CORS allowlisting.
APP_URL=http://localhost:5173
# Comma-separated extra allowed origins (production).
ALLOWED_ORIGINS=

# -- Attachment storage -------------------------------------------------------
# Leave empty in development: files fall back to local uploads/.
# Required in production, because serverless filesystems are ephemeral.
BLOB_READ_WRITE_TOKEN=

# -- Rate limiting (optional) -------------------------------------------------
# Without these, an in-memory per-instance fixed-window limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -- Monitoring (optional) ----------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# First administrator (only read by `bun run seed:admin`)
# -----------------------------------------------------------------------------
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=
# At least 10 characters, including a letter and a number.
SEED_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Local development / tests only
# -----------------------------------------------------------------------------
# pglite runs an embedded Postgres so no external database is needed.
# DTS_DB_DRIVER=pglite
# Directory for local attachment storage (defaults to apps/api/uploads).
# DTS_STORAGE_DIR=